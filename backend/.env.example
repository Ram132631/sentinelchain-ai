# Copy this file to backend/.env and fill in what you have.
# EVERY value below is optional — the platform runs fully in DEMO MODE
# with zero configuration.

# --- GitHub (optional) ---
# Raises API rate limits and allows scanning private repos. Without it,
# public repos are still scanned (rate-limited), and anything unreachable
# falls back to the built-in demo-commerce-api dataset.
GITHUB_TOKEN=

# --- Anthropic Claude (optional) ---
# Powers natural-language "why is this dangerous / why is this patch safe"
# explanations. Without it, deterministic rule-based explanations are used.
ANTHROPIC_API_KEY=

# --- Database ---
# Defaults to a local SQLite file at backend/data/sentinelchain.db.
# For Postgres, set e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/sentinelchain
DATABASE_URL=

# --- CORS (JSON array of allowed frontend origins) ---
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
