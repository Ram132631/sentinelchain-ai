# Root .env for `docker compose up`. Copy to `.env` and fill in what you have —
# every value is optional; the platform runs fully in DEMO MODE without any of it.

# --- GitHub (optional): raises API rate limits, allows private repos ---
GITHUB_TOKEN=

# --- Anthropic Claude (optional): natural-language risk/patch explanations ---
ANTHROPIC_API_KEY=

# --- Frontend -> backend API base (used only for non-default setups) ---
VITE_API_BASE_URL=/api
